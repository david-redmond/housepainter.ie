# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this .env.example is committed as documentation.

# --- Email (Resend) — server-side only, secret ---
# API key from https://resend.com/api-keys
RESEND_API_KEY=
# Where quote notifications are sent (comma-separated for multiple recipients)
EMAIL_TO=
# Verified sender address configured in Resend
EMAIL_FROM=

# --- Google Analytics 4 ---
# Measurement ID (looks like G-XXXXXXXXXX).
# NOTE: NEXT_PUBLIC_ vars are inlined into the client bundle at build time,
# so this must be present in the build environment to take effect.
NEXT_PUBLIC_GA_ID=
